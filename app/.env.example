# Set ONE of these. First one found wins.
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional
# Comma-separated: primary first, then fallbacks used when a model is busy (503/429).
# Gemini default: gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite
# LLM_MODEL=gemini-3.5-flash
# LLM_REASONING_EFFORT=low
# DATA_DIR=./data
# PORT=3000
# HTTPS_PROXY=

# Deployment (server-only; never exposed to the browser bundle)
# Required in production: the server refuses to start without it. 12+ random characters.
# Users sign in with any username and this value as the password (browser prompt).
# DEMO_ACCESS_KEY=
# Production only: allow "Reset demo data" (off by default).
# ENABLE_RESET=true
# Production only: knowingly run with no access key (not recommended).
# ALLOW_OPEN_ACCESS=true
# HOST=0.0.0.0
